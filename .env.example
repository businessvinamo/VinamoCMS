# Supabase · Projekt "Vinamo CMS Staging" (Region Zürich, eu-central-2)
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur für den Isolationstest und für Hintergrundjobs. Niemals in den Browser,
# niemals in eine Client-Komponente, niemals ins Repository.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Zieladresse für die Links in den Anmelde-E-Mails.
# Lokal: http://localhost:3000 · Produktion: https://admin.vinamo.ch
NEXT_PUBLIC_SITE_URL=http://localhost:3000
